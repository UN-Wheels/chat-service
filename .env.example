# ============================================
# UniWheels Chat Service — Environment Variables
# ============================================

# Servidor
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/uniwheels_chat

# JWT (debe coincidir con el servicio principal)
JWT_ACCESS_SECRET=your_jwt_secret_here

# CORS
CORS_ORIGIN=http://localhost:5173

# API Gateway (fase 2 — no requerido en MVP)
# API_GATEWAY_URL=http://localhost:3000
